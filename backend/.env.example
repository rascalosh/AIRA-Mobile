# Copy to .env and adjust. Lists are comma-separated.
STORAGE_DIR=storage
MAX_UPLOAD_MB=1024
STUDY_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
ALLOWED_MODALITIES=T2W,DWI,ADC
REQUIRED_MODALITIES=T2W
CORS_ORIGINS=*

# External ML Model API (Phase 3) — server-side only, never shipped in the mobile app.
ML_API_URL=
ML_API_KEY=
ML_API_TIMEOUT_SECONDS=300
