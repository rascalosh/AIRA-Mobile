# Copy to .env and adjust. Lists are comma-separated.
STORAGE_DIR=storage
MAX_UPLOAD_MB=1024
STUDY_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
ALLOWED_MODALITIES=T2W,DWI,ADC
REQUIRED_MODALITIES=T2W

# Security. The mobile app needs no CORS: leave empty unless a web client exists (never use *).
CORS_ORIGINS=
# Serve /docs and /openapi.json (development only).
DOCS_ENABLED=false
# Abuse limits (requests per RATE_LIMIT_WINDOW_SECONDS; registration is per client address, the rest per user).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER=10
RATE_LIMIT_UPLOAD=6
RATE_LIMIT_SEGMENT=6
RATE_LIMIT_EDIT=120
MAX_STUDIES_PER_USER=10
MAX_ACTIVE_JOBS_PER_USER=2
MAX_UPLOAD_FILES=5000
MAX_ZIP_MEMBERS=10000
MAX_VOLUME_VOXELS=64000000

# External ML Model API (Phase 3) — server-side only, never shipped in the mobile app.
ML_API_URL=
ML_API_KEY=
ML_API_TIMEOUT_SECONDS=300
