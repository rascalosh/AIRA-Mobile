# Copy to .env (git-ignored) and change both values. Use letters and digits only: the password is used in a URL.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Optional. By default the API listens on this computer only; use 0.0.0.0 to reach it from a phone on your network.
# API_BIND=127.0.0.1
# Serve /docs and /openapi.json (development only).
# DOCS_ENABLED=false
